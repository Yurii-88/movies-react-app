    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^7.8.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
