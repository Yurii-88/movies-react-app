{
  "name": "tmdb-fullstack-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A full-stack movie browsing application powered by TMDB API and built with React, Node.js, PostgreSQL and Prisma ORM.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "author": "Yurii Matviichuk <matviychuk.yuriy88@gmail.com>",
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "lint:frontend": "eslint frontend --ext .ts,.tsx,.js,.jsx",
    "lint:backend": "eslint backend --ext .ts,.js",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "backend/**/*.{ts,js}": [
      "eslint --fix"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7"
  }
}
